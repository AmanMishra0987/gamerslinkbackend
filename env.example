# Copy to ".env" and fill with your real values. Never commit ".env" to git.

# Database
MONGODB_URI=mongodb://localhost:27017/arc-esports

# JWT
JWT_SECRET=change_me
JWT_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server
PORT=5000
NODE_ENV=development

# Proxy (optional; needed on Render behind a proxy for correct req.ip)
# TRUST_PROXY=1

